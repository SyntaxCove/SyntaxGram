{
  "name": "syntaxgram",
  "productName": "SyntaxGram",
  "version": "0.2.4",
  "description": "SyntaxGram — Instagram Web as a native-feeling Windows desktop app with a privacy-friendly media download manager",
  "main": "dist/main/index.js",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "SyntaxCove"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "node scripts/clean.mjs dist/preload && vite build --config vite.preload.config.ts --mode index && vite build --config vite.preload.config.ts --mode instagram",
    "build:injection": "vite build --config vite.injection.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:injection && npm run build:renderer",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run typecheck && npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "icon": "python3 scripts/make_icon.py"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.30.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.48.0",
    "prettier": "^3.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  }
}
